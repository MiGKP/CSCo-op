datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique
  passwordHash String
  tempPassword String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id        String   @id @default(cuid())
  name      String
  province  String
  position  String
  address   String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoopRecord {
  id              String   @id @default(cuid())
  studentId       String   @unique
  companyName     String
  companyProvince String
  jobPosition     String
  companyAddress  String
  detail          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ApiClient {
  id        String   @id @default(cuid())
  name      String
  tokenHash String   @unique
  createdAt DateTime @default(now())
}
