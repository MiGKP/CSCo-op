# Neon PostgreSQL (required). Use the pooled string for the app.
# Dashboard → Connect → "Pooled connection" (hostname has -pooler).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) string for Prisma migrate. Hostname has no -pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Bearer Token for Student Portal API access
STUDENT_WEB_API_TOKEN="coop_secret_token_2026_student_portal"

# Instructor Web Portal Credentials
INSTRUCTOR_USERNAME="admin"
INSTRUCTOR_PASSWORD="coop2026pass"
INSTRUCTOR_SESSION_SECRET="cs_coop_instructor_secret_key_2026_super_secure"
